{
  "name": "9bflayer",
  "version": "0.1.0",
  "description": "9bFlayer: a mineflayer fork that plays like the vanilla client, built to pass the Grim anticheat (9b9t). Drop-in for mineflayer 4.39.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "mocha_test": "mocha --reporter ./test/common/durationsReporter.js --exit",
    "test": "npm run mocha_test",
    "pretest": "npm run lint",
    "lint": "standard && standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Br0xx/EldiaMineflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "^3.114.0",
    "minecraft-protocol": "^1.67.0",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "^1.41.0",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "^1.17.0",
    "prismarine-nbt": "^2.0.0",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "minecraft-wrap": "^1.3.0",
    "mineflayer": "./",
    "mocha": "^11.0.1",
    "protodef-yaml": "^1.5.3",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "grim",
    "anticheat",
    "vanilla",
    "9b9t"
